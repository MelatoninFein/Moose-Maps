<?xml version="1.0" encoding="utf-8"?>
<!--
  One attempt in a ranked list. Rank and time are the two things being compared, so they lead; the
  date and heart rate sit underneath where they can be read without competing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:minHeight="@dimen/height_item_oneline"
  android:orientation="horizontal"
  android:paddingTop="@dimen/margin_quarter"
  android:paddingBottom="@dimen/margin_quarter">

  <TextView
    android:id="@+id/run_rank"
    android:layout_width="@dimen/cycling_rank_width"
    android:layout_height="wrap_content"
    android:textAppearance="@style/MwmTextAppearance.Body2"
    tools:text="1" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/run_time"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:lines="1"
      android:textAppearance="@style/MwmTextAppearance.Body1"
      tools:text="14m 02s" />

    <TextView
      android:id="@+id/run_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:lines="1"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      tools:text="28 Jul 2026 · 162 bpm" />
  </LinearLayout>

  <TextView
    android:id="@+id/run_badge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textAppearance="@style/MwmTextAppearance.Body4"
    android:visibility="gone"
    tools:text="PB"
    tools:visibility="visible" />
</LinearLayout>
