<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cycling_settings_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_base">

    <!--
      What this fork adds, once.

      Nothing described any of it anywhere: sensors, ride recording and racing yourself were
      discoverable only by opening every screen and guessing. A card that is read once and
      dismissed says it without turning first launch into a tour nobody asked for.
    -->
    <LinearLayout
      android:id="@+id/cycling_intro"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/margin_base"
      android:background="@drawable/cycling_panel_bg"
      android:orientation="vertical"
      android:padding="@dimen/margin_base"
      android:visibility="gone">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cycling_intro_body"
        android:textAppearance="@style/MwmTextAppearance.Body3" />

      <Button
        android:id="@+id/cycling_intro_dismiss"
        style="@style/CyclingMediaAppButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/margin_half"
        android:text="@string/cycling_intro_dismiss" />
    </LinearLayout>

    <!--
      Headings, because this screen is otherwise seventeen controls in one undifferentiated column:
      two navigation buttons, a switch, two text fields, two lists, a scan and a permission link,
      with nothing saying which belong together. Three groups match the three reasons to be here -
      look at what you rode, connect what measures it, tell it about your bike.
    -->
    <TextView
      style="@style/CyclingSettingsHeading"
      android:text="@string/cycling_section_records" />

    <!-- Rides and Segments live inside Cycling, so Settings carries one cycling entry rather than
         four scattered through the general list. -->
    <Button
      android:id="@+id/cycling_open_rides"
      style="@style/CyclingMediaAppButton"
      android:text="@string/cycling_rides_title" />

    <Button
      android:id="@+id/cycling_open_segments"
      style="@style/CyclingMediaAppButton"
      android:text="@string/cycling_segments_title" />


    <TextView
      style="@style/CyclingSettingsHeading"
      android:text="@string/cycling_section_bike" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingTop="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_wheel_circumference"
      android:textAppearance="@style/MwmTextAppearance.Body2" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:paddingBottom="@dimen/margin_half"
      android:text="@string/cycling_wheel_circumference_summary"
      android:textAppearance="@style/MwmTextAppearance.Body4" />

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/cycling_wheel_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:layout_marginEnd="@dimen/margin_base"
      app:suffixText="@string/cycling_unit_mm">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/cycling_wheel_circumference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4"
        tools:text="2105" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingTop="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_max_hr_title"
      android:textAppearance="@style/MwmTextAppearance.Body2" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:paddingBottom="@dimen/margin_half"
      android:text="@string/cycling_max_hr_summary"
      android:textAppearance="@style/MwmTextAppearance.Body4" />

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/cycling_max_hr_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:layout_marginEnd="@dimen/margin_base"
      app:suffixText="@string/cycling_unit_bpm">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/cycling_max_hr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
      style="@style/CyclingSettingsHeading"
      android:text="@string/cycling_section_sensors" />

    <androidx.appcompat.widget.SwitchCompat
      android:id="@+id/cycling_sensors_enabled"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/height_item_oneline"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_sensors_enable"
      android:textAppearance="@style/MwmTextAppearance.Body1" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingTop="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_sensors_paired"
      android:textAppearance="@style/MwmTextAppearance.Body2" />

    <LinearLayout
      android:id="@+id/cycling_paired_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/cycling_paired_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingTop="@dimen/margin_half"
      android:paddingEnd="@dimen/margin_base"
      android:paddingBottom="@dimen/margin_half"
      android:text="@string/cycling_sensors_none_paired"
      android:textAppearance="@style/MwmTextAppearance.Body4" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingTop="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_sensors_available"
      android:textAppearance="@style/MwmTextAppearance.Body2" />

    <LinearLayout
      android:id="@+id/cycling_discovered_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

    <Button
      android:id="@+id/cycling_scan_button"
      style="@style/CyclingPrimaryButton"
      android:layout_marginStart="@dimen/margin_half"
      android:text="@string/cycling_sensors_scan" />

    <!-- Scan-time feedback: permission refusals, Bluetooth being off, nothing found. -->
    <TextView
      android:id="@+id/cycling_sensor_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:paddingBottom="@dimen/margin_half"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone"
      tools:text="Turn Bluetooth on to search for sensors."
      tools:visibility="visible" />
  </LinearLayout>
</ScrollView>
