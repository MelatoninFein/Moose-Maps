<?xml version="1.0" encoding="utf-8"?>
<!--
  What replaces the whole map UI while the app is in picture-in-picture.

  A PiP window is roughly the size of a business card and cannot receive touches, so everything
  interactive is gone: what remains is the next manoeuvre and the sensor readout, which is exactly
  what a rider glances at. Transport controls live in the PiP action bar instead (see PipController).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cycling_pip_overlay"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_alignParentBottom="true"
  android:background="@color/bg_pip_scrim"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="@dimen/margin_half"
  android:paddingTop="@dimen/margin_quarter"
  android:paddingEnd="@dimen/margin_half"
  android:paddingBottom="@dimen/margin_quarter"
  android:visibility="gone"
  tools:visibility="visible">

  <TextView
    android:id="@+id/pip_next_turn"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:ellipsize="end"
    android:lines="1"
    android:textAppearance="@style/MwmTextAppearance.Body2.Light"
    tools:text="450 m · turn right" />

  <app.organicmaps.cycling.ui.SensorTileView
    android:id="@+id/pip_tile_heart_rate"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_half"
    app:tileCompact="true"
    app:tileLabel="@string/cycling_unit_bpm" />

  <app.organicmaps.cycling.ui.SensorTileView
    android:id="@+id/pip_tile_speed"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_half"
    app:tileCompact="true"
    app:tileLabel="@string/cycling_unit_kmh" />

  <app.organicmaps.cycling.ui.SensorTileView
    android:id="@+id/pip_tile_power"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_half"
    app:tileCompact="true"
    app:tileLabel="@string/cycling_unit_watts" />
</LinearLayout>
