<?xml version="1.0" encoding="utf-8"?>
<!--
  Live segment readout. Top-centre, under the compass row, and only visible while actually on a
  segment - a permanent widget for something that applies a few minutes per ride is wasted map.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cycling_segment_banner"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:layout_alignParentTop="true"
  android:layout_centerHorizontal="true"
  android:background="@drawable/cycling_panel_bg"
  android:gravity="center"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base"
  android:paddingTop="@dimen/margin_half"
  android:paddingEnd="@dimen/margin_base"
  android:paddingBottom="@dimen/margin_half"
  android:visibility="gone"
  tools:visibility="visible">
  <TextView
    android:id="@+id/segment_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:lines="1"
    android:textAppearance="@style/MwmTextAppearance.Body4"
    tools:text="Höllviken runt" />
  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <!--
      The gap leads, at a size meant to be caught rather than read. It is the only figure here that
      changes what a rider does in the next ten seconds, and at 35 km/h a glance is all it gets;
      the elapsed time is context and sits small beside it.
    -->
    <TextView
      android:id="@+id/segment_delta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="@dimen/cycling_delta_text"
      android:textStyle="bold"
      tools:text="+4s" />
    <TextView
      android:id="@+id/segment_elapsed"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_half"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      tools:text="4:32" />
  </LinearLayout>

  <!--
    The gap as a bar growing from the centre, the way every racing game draws it. Left is ahead,
    right is behind, and which side is filled registers long before a number could be read.
  -->
  <app.organicmaps.cycling.rides.DeltaBarView
    android:id="@+id/segment_delta_bar"
    android:layout_width="@dimen/cycling_segment_progress_width"
    android:layout_height="@dimen/cycling_delta_bar_height"
    android:layout_marginTop="@dimen/margin_quarter" />

  <!--
    Three sector lights. Purple, green and yellow mean on a bike exactly what they mean on a timing
    screen, so a rider who has watched a race needs no explanation: it says where the lap went, and
    says it at the top of the climb rather than at the finish.
  -->
  <app.organicmaps.cycling.rides.SectorLightsView
    android:id="@+id/segment_sectors"
    android:layout_width="@dimen/cycling_segment_progress_width"
    android:layout_height="@dimen/cycling_sector_light_height"
    android:layout_marginTop="@dimen/margin_quarter" />
</LinearLayout>