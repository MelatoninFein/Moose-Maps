<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/coordinator"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <RelativeLayout
    android:id="@+id/map_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <app.organicmaps.sdk.MapView
      android:id="@+id/map"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <include
      android:id="@+id/onmap_downloader"
      layout="@layout/onmap_downloader"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true" />

    <include
      android:id="@+id/position_chooser"
      layout="@layout/position_chooser" />

    <include
      android:id="@+id/toolbar"
      layout="@layout/toolbar_with_search"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentBottom="true"
      android:visibility="gone"
      tools:visibility="visible" />

    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/map_buttons"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <include
      layout="@layout/layout_nav"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:paddingBottom="@dimen/margin_base"
      android:visibility="invisible" />

    <!-- Compass, top-right. Speed in the middle (GPS by default), waypoint dots on the rim. -->
    <include layout="@layout/cycling_ride_status" />

    <include layout="@layout/cycling_segment_banner" />

    <app.organicmaps.cycling.ui.CompassView
      android:id="@+id/cycling_compass"
      android:layout_width="@dimen/cycling_compass_size"
      android:layout_height="@dimen/cycling_compass_size"
      android:layout_alignParentTop="true"
      android:layout_alignParentEnd="true"
      android:layout_marginTop="@dimen/cycling_compass_top_allowance"
      android:layout_marginEnd="@dimen/margin_half" />

    <!-- Heart rate, cadence and power. Under the compass and end-aligned with it; each tile hides
         itself when nothing is reporting, so a rider with no sensors sees nothing at all. -->
    <LinearLayout
      android:id="@+id/cycling_live_tiles"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_below="@+id/cycling_compass"
      android:layout_alignEnd="@+id/cycling_compass"
      android:layout_marginTop="@dimen/margin_half"
      android:background="@drawable/cycling_panel_bg"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingStart="@dimen/margin_half"
      android:paddingTop="@dimen/margin_quarter"
      android:paddingEnd="@dimen/margin_half"
      android:paddingBottom="@dimen/margin_quarter">

      <app.organicmaps.cycling.ui.SensorTileView
        android:id="@+id/live_heart_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:tileLabel="@string/cycling_unit_bpm" />

      <app.organicmaps.cycling.ui.SensorTileView
        android:id="@+id/live_cadence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:tileLabel="@string/cycling_unit_rpm" />

      <app.organicmaps.cycling.ui.SensorTileView
        android:id="@+id/live_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:tileLabel="@string/cycling_unit_watts" />
    </LinearLayout>
  </RelativeLayout>
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/search_container_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:name="app.organicmaps.search.SearchFragmentController" />
  <FrameLayout
    android:id="@+id/routing_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/place_page_container_fragment"
    android:name="app.organicmaps.widget.placepage.PlacePageController"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
