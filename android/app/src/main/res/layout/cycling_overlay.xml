<?xml version="1.0" encoding="utf-8"?>
<!--
  Live data panels along the bottom of the map, with a chevron to collapse them.

  Bottom rather than top: it is the edge a rider glances at without moving their head far off the
  road, and it leaves the top clear for the compass. The strip sits above the map's own bottom
  button bar so it never covers search or the menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cycling_overlay"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_alignParentBottom="true"
  android:layout_marginBottom="@dimen/cycling_panel_bottom_margin"
  android:gravity="center_horizontal"
  android:orientation="vertical">

  <!-- Collapse/expand handle. Always present, so the panels can be brought back once hidden. -->
  <ImageView
    android:id="@+id/cycling_panel_toggle"
    android:layout_width="@dimen/cycling_toggle_size"
    android:layout_height="@dimen/cycling_toggle_size"
    android:background="@drawable/cycling_panel_bg"
    android:contentDescription="@string/cycling_panels_toggle"
    android:scaleType="center"
    app:srcCompat="@drawable/ic_expand_more"
    app:tint="?iconTint" />

  <LinearLayout
    android:id="@+id/cycling_sensor_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_quarter"
    android:background="@drawable/cycling_panel_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_base"
    android:paddingTop="@dimen/margin_half"
    android:paddingEnd="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_half"
    tools:visibility="visible">

    <!-- GPS speed is always available, so it is the one panel that never shows a placeholder. -->
    <app.organicmaps.cycling.ui.SensorTileView
      android:id="@+id/tile_gps_speed"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/margin_base"
      android:minWidth="@dimen/cycling_tile_min_width"
      app:tileLabel="@string/cycling_unit_kmh" />

    <app.organicmaps.cycling.ui.SensorTileView
      android:id="@+id/tile_heart_rate"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/margin_base"
      android:minWidth="@dimen/cycling_tile_min_width"
      app:tileLabel="@string/cycling_unit_bpm" />

    <app.organicmaps.cycling.ui.SensorTileView
      android:id="@+id/tile_cadence"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/margin_base"
      android:minWidth="@dimen/cycling_tile_min_width"
      app:tileLabel="@string/cycling_unit_rpm" />

    <app.organicmaps.cycling.ui.SensorTileView
      android:id="@+id/tile_speed"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/margin_base"
      android:minWidth="@dimen/cycling_tile_min_width"
      app:tileLabel="@string/cycling_unit_kmh" />

    <app.organicmaps.cycling.ui.SensorTileView
      android:id="@+id/tile_power"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="@dimen/cycling_tile_min_width"
      app:tileLabel="@string/cycling_unit_watts" />
  </LinearLayout>
</LinearLayout>
