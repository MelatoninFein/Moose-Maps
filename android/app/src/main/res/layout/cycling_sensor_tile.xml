<?xml version="1.0" encoding="utf-8"?>
<!-- Contents of SensorTileView; the view itself supplies the vertical LinearLayout. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  tools:parentTag="android.widget.LinearLayout">

  <TextView
    android:id="@+id/tile_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:lines="1"
    android:textAppearance="@style/MwmTextAppearance.NavMenu.Number"
    tools:text="164" />

  <TextView
    android:id="@+id/tile_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:lines="1"
    android:textAppearance="@style/MwmTextAppearance.NavMenu.Number.Dimension"
    tools:text="bpm" />
</merge>
