<?xml version="1.0" encoding="utf-8"?>
<!--
  Music controls as a floating action button that opens an off-canvas panel from the trailing edge.

  Replaces the earlier always-on bar across the top of the map: playback is something a rider
  reaches for occasionally, so it should cost one tap and no permanent map real estate. The panel
  is deliberately full height and finger-sized - it gets used with gloves on, at a junction.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/cycling_media_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <!-- Catches taps outside the panel to dismiss it. Not clickable until the panel opens, so it
       never steals touches from the map. -->
  <View
    android:id="@+id/cycling_media_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pip_scrim"
    android:visibility="gone"
    tools:visibility="visible" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/cycling_media_fab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_margin="@dimen/margin_base"
    android:contentDescription="@string/cycling_music_title"
    android:visibility="gone"
    app:srcCompat="@drawable/ic_cycling_music"
    tools:visibility="visible" />

  <LinearLayout
    android:id="@+id/cycling_media_panel"
    android:layout_width="@dimen/cycling_panel_width"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="?cardBackground"
    android:orientation="vertical"
    android:padding="@dimen/margin_base"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/cycling_music_title"
        android:textAppearance="@style/MwmTextAppearance.Body2" />

      <ImageView
        android:id="@+id/cycling_media_close"
        android:layout_width="@dimen/cycling_icon_size"
        android:layout_height="@dimen/cycling_icon_size"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        app:srcCompat="@drawable/ic_close"
        app:tint="?iconTint" />
    </LinearLayout>

    <ImageView
      android:id="@+id/cycling_media_artwork"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cycling_panel_artwork_size"
      android:layout_marginTop="@dimen/margin_base"
      android:adjustViewBounds="true"
      android:contentDescription="@string/cycling_music_title"
      android:scaleType="centerCrop"
      app:srcCompat="@drawable/ic_cycling_music"
      app:tint="?iconTint" />

    <TextView
      android:id="@+id/cycling_media_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:ellipsize="end"
      android:maxLines="2"
      android:textAppearance="@style/MwmTextAppearance.Body1"
      tools:text="Unknown Pleasures" />

    <TextView
      android:id="@+id/cycling_media_subtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:lines="1"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      tools:text="Joy Division · Spotify" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageButton
        android:id="@+id/cycling_media_previous"
        android:layout_width="@dimen/cycling_panel_button"
        android:layout_height="@dimen/cycling_panel_button"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/cycling_music_previous"
        app:srcCompat="@drawable/ic_cycling_previous"
        app:tint="?iconTint" />

      <ImageButton
        android:id="@+id/cycling_media_play_pause"
        android:layout_width="@dimen/cycling_panel_button"
        android:layout_height="@dimen/cycling_panel_button"
        android:layout_marginStart="@dimen/margin_base"
        android:layout_marginEnd="@dimen/margin_base"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/cycling_music_play_pause"
        app:srcCompat="@drawable/ic_cycling_play"
        app:tint="?colorAccent" />

      <ImageButton
        android:id="@+id/cycling_media_next"
        android:layout_width="@dimen/cycling_panel_button"
        android:layout_height="@dimen/cycling_panel_button"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/cycling_music_next"
        app:srcCompat="@drawable/ic_cycling_next"
        app:tint="?iconTint" />
    </LinearLayout>

    <!-- Shown when no player is publishing a session: launching one creates it. -->
    <TextView
      android:id="@+id/cycling_media_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:text="@string/cycling_music_nothing_playing"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone"
      tools:visibility="visible" />

    <LinearLayout
      android:id="@+id/cycling_media_apps"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:orientation="vertical" />
  </LinearLayout>
</FrameLayout>
