<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rides_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_base">
    <TextView
      android:id="@+id/rides_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_rides_empty"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone" />

    <!-- An empty state that only describes what is missing leaves the rider to find the way back
         to the map themselves. Recording starts there, so this goes there. -->
    <Button
      android:id="@+id/rides_empty_action"
      style="@style/CyclingMediaAppButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:layout_marginTop="@dimen/margin_half"
      android:text="@string/cycling_rides_empty_action"
      android:visibility="gone" />

    <!-- What a cyclist actually wants first: how much riding this month came to. Same tiles as the
         ride screen, so a figure means the same thing wherever it appears. -->
    <TextView
      android:id="@+id/totals_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_totals_title"
      android:textAppearance="@style/MwmTextAppearance.Body2"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/totals_grid"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:layout_marginTop="@dimen/margin_half"
      android:layout_marginEnd="@dimen/margin_base"
      android:background="@drawable/cycling_panel_bg"
      android:orientation="vertical"
      android:padding="@dimen/margin_half" />

    <TextView
      android:id="@+id/records_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:paddingStart="@dimen/margin_base"
      android:paddingEnd="@dimen/margin_base"
      android:text="@string/cycling_records_title"
      android:textAppearance="@style/MwmTextAppearance.Body2"
      android:visibility="gone" />

    <!-- Fastest ever over each distance, as tiles rather than a text block: a personal best is a
         figure to be recognised, and a paragraph makes it something to be read. -->
    <LinearLayout
      android:id="@+id/records_grid"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:layout_marginTop="@dimen/margin_half"
      android:layout_marginEnd="@dimen/margin_base"
      android:layout_marginBottom="@dimen/margin_base"
      android:background="@drawable/cycling_panel_bg"
      android:orientation="vertical"
      android:padding="@dimen/margin_half" />

    <LinearLayout
      android:id="@+id/rides_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
