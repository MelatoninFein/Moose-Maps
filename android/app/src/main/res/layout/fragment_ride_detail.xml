<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/ride_detail_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_base">
    <TextView
      android:id="@+id/ride_detail_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/cycling_rides_unreadable"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone" />
    <!--
      Shown only when arriving straight from the finish.

      The ride is already on disk by this point - recording writes as it goes, so there is nothing
      to "save" and a Save button would be theatre. What a rider actually needs at the line is the
      chance to name it while they still remember what it was, to keep a copy outside the app, and
      to throw away a false start before it clutters the list forever.
    -->
    <LinearLayout
      android:id="@+id/ride_finish_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/margin_base"
      android:background="@drawable/cycling_panel_bg"
      android:orientation="vertical"
      android:padding="@dimen/margin_base"
      android:visibility="gone"
      tools:visibility="visible">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cycling_ride_finished"
        android:textAppearance="@style/MwmTextAppearance.Body2" />

      <!-- Segments beaten, listed rather than fired off as a queue of toasts nobody can re-read. -->
      <TextView
        android:id="@+id/ride_finish_bests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_half"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/MwmTextAppearance.Body3"
        android:visibility="gone"
        tools:text="Höllviken runt — 14:02, a personal best" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_half"
        android:orientation="horizontal">

        <Button
          android:id="@+id/ride_finish_name"
          style="@style/CyclingPrimaryButton"
          android:text="@string/cycling_ride_name_title" />

        <Button
          android:id="@+id/ride_finish_discard"
          style="@style/CyclingMediaAppButton"
          android:layout_width="wrap_content"
          android:layout_marginStart="@dimen/margin_half"
          android:text="@string/cycling_ride_discard" />
      </LinearLayout>
    </LinearLayout>

    <app.organicmaps.cycling.rides.RideTraceView
      android:id="@+id/ride_trace"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cycling_trace_height"
      android:background="@drawable/cycling_panel_bg" />
    <!-- Chips, not buttons: on this screen a chip chooses what you are looking at and a button does
         something. Two vocabularies for the same job - these picked the trace metric while the pair
         below the chart picked the chart series - made identical decisions look unrelated, and left
         the trace with no indication of which metric was actually being shown. -->
    <com.google.android.material.chip.ChipGroup
      android:id="@+id/ride_trace_metric"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:selectionRequired="true"
      app:singleSelection="true">
      <com.google.android.material.chip.Chip
        android:id="@+id/chip_trace_speed"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/cycling_metric_speed" />
      <com.google.android.material.chip.Chip
        android:id="@+id/chip_trace_heart_rate"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cycling_metric_heart_rate" />
    </com.google.android.material.chip.ChipGroup>
    <!-- Figures as tiles rather than a paragraph: a rider scans these, they do not read them. -->
    <LinearLayout
      android:id="@+id/ride_stats_grid"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:background="@drawable/cycling_panel_bg"
      android:orientation="vertical"
      android:padding="@dimen/margin_half" />

    <!-- Sensors over the ride: where you buried yourself, not just the average. -->
    <app.organicmaps.cycling.rides.RideChartView
      android:id="@+id/ride_chart"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cycling_chart_height"
      android:layout_marginTop="@dimen/margin_half"
      android:background="@drawable/cycling_panel_bg" />

    <com.google.android.material.chip.ChipGroup
      android:id="@+id/ride_chart_series"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:singleSelection="false">
      <com.google.android.material.chip.Chip
        android:id="@+id/chip_hr"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/cycling_metric_heart_rate" />
      <com.google.android.material.chip.Chip
        android:id="@+id/chip_speed"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/cycling_metric_speed" />
      <com.google.android.material.chip.Chip
        android:id="@+id/chip_cadence"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cycling_metric_cadence" />
      <com.google.android.material.chip.Chip
        android:id="@+id/chip_power"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cycling_metric_power" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
      android:id="@+id/ride_zones_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:text="@string/cycling_zones_title"
      android:textAppearance="@style/MwmTextAppearance.Body2"
      android:visibility="gone" />

    <app.organicmaps.cycling.rides.ZoneBarView
      android:id="@+id/ride_zone_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cycling_zone_bar_height"
      android:layout_marginTop="@dimen/margin_quarter"
      android:visibility="gone" />

    <!-- Shown instead of the bar until the rider has given their own maximum. Zones drawn from the
         default guess would look exactly as authoritative while being wrong by a whole band. -->
    <TextView
      android:id="@+id/ride_zones_prompt"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_quarter"
      android:background="?selectableItemBackground"
      android:paddingTop="@dimen/margin_half"
      android:paddingBottom="@dimen/margin_half"
      android:text="@string/cycling_zones_need_max"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone" />

    <!-- Said only when a sensor was missing for a meaningful part of the ride. An average computed
         over two thirds of a ride is not wrong, but reading it as the whole ride is. -->
    <TextView
      android:id="@+id/ride_coverage"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone"
      tools:text="Heart rate recorded for 62% of this ride" />

    <TextView
      android:id="@+id/ride_detail_stats"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:lineSpacingExtra="4dp"
      android:textAppearance="@style/MwmTextAppearance.Body3" />
    <!-- Segment trimming: pick a stretch inside the ride rather than saving the whole outing.
         Hidden until asked for. Most visits to this screen are to look at a ride, not to cut a
         segment out of it, and a slider that does nothing on those visits is just clutter that
         also invites an accidental drag. -->
    <TextView
      android:id="@+id/ride_trim_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone"
      tools:text="Segment covers 4.3 km of this ride"
      tools:visibility="visible" />

    <com.google.android.material.slider.RangeSlider
      android:id="@+id/ride_trim"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:valueFrom="0"
      android:valueTo="100"
      android:visibility="gone"
      tools:visibility="visible" />

    <!-- Both actions together at the end. Export used to sit between the zone bar and the trim
         block, so the two things you can do with a ride were separated by a control belonging to
         only one of them. -->
    <Button
      android:id="@+id/ride_save_segment"
      style="@style/CyclingMediaAppButton"
      android:layout_marginTop="@dimen/margin_base"
      android:text="@string/cycling_segment_save" />

    <Button
      android:id="@+id/ride_export_gpx"
      style="@style/CyclingMediaAppButton"
      android:text="@string/cycling_rides_export" />
  </LinearLayout>
</ScrollView>