<?xml version="1.0" encoding="utf-8"?>
<!--
  One segment in full.

  The attempt list used to expand inside the row as a block of monospaced-looking text: two ranked
  tables crammed into a single label, with no picture of the course they belonged to. A segment you
  race all season deserves a screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/segment_detail_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_base">

    <!-- Where it goes. Drawn grey: a course has no speeds of its own to be graded by. -->
    <app.organicmaps.cycling.rides.RideTraceView
      android:id="@+id/segment_course"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cycling_trace_height"
      android:background="@drawable/cycling_panel_bg" />

    <LinearLayout
      android:id="@+id/segment_stats_grid"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:background="@drawable/cycling_panel_bg"
      android:orientation="vertical"
      android:padding="@dimen/margin_half" />

    <!-- Are you getting faster? Answered before any time is read. -->
    <app.organicmaps.cycling.rides.SparklineView
      android:id="@+id/segment_detail_sparkline"
      android:layout_width="match_parent"
      android:layout_height="@dimen/cycling_sparkline_detail_height"
      android:layout_marginTop="@dimen/margin_half"
      android:background="@drawable/cycling_panel_bg"
      android:visibility="gone" />

    <TextView
      android:id="@+id/segment_all_time_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:text="@string/cycling_segment_top_all_time"
      android:textAppearance="@style/MwmTextAppearance.Body2" />

    <LinearLayout
      android:id="@+id/segment_all_time_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/segment_session_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_base"
      android:text="@string/cycling_segment_top_session"
      android:textAppearance="@style/MwmTextAppearance.Body2"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/segment_session_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/segment_detail_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:text="@string/cycling_segment_runs_none"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      android:visibility="gone"
      tools:visibility="visible" />
  </LinearLayout>
</ScrollView>
