<?xml version="1.0" encoding="utf-8"?>
<!-- Dimensions and colours for the cycling features. Kept in their own file so the fork's
     additions stay separate from upstream resources and rebases don't conflict. -->
<resources>
  <dimen name="cycling_panel_min_width">120dp</dimen>
  <dimen name="cycling_tile_min_width">56dp</dimen>
  <dimen name="cycling_artwork_size">40dp</dimen>
  <dimen name="cycling_media_button">44dp</dimen>
  <dimen name="cycling_icon_size">24dp</dimen>
  <!--
    Icon buttons are laid out at this size with the padding below, so the glyph still draws at
    cycling_icon_size while the tappable box meets the 48dp minimum. The ride pause and stop are
    pressed at speed and possibly through gloves; a 24dp target is a miss waiting to happen.
  -->
  <dimen name="cycling_touch_target">48dp</dimen>
  <dimen name="cycling_touch_padding">12dp</dimen>
  <dimen name="cycling_toggle_size">32dp</dimen>
  <dimen name="cycling_panel_bottom_margin">96dp</dimen>

  <!-- Off-canvas music panel -->
  <dimen name="cycling_panel_width">300dp</dimen>
  <dimen name="cycling_panel_artwork_size">180dp</dimen>
  <dimen name="cycling_panel_button">56dp</dimen>

  <!-- Scrim behind the picture-in-picture readout: dark enough to stay legible over any map. -->
  <color name="bg_pip_scrim">#B3000000</color>

  <!-- Compass dial: legible over any map, in either theme. -->
  <color name="bg_compass">#CCFFFFFF</color>
  <!-- Green when ahead of your best, red when behind. -->
  <color name="segment_ahead">#2E7D32</color>
  <color name="segment_behind">#C62828</color>

  <!-- The unlit parts of the race HUD. These sit on a card that follows the theme, so they cannot
       be a fixed white: on a light card a translucent white reads as nothing at all. -->
  <!-- The terrain the other chart lines are read against: quiet enough not to compete. -->
  <color name="chart_elevation_fill">#14000000</color>
  <color name="chart_elevation_line">#40000000</color>
  <color name="hud_track">#1F000000</color>
  <color name="hud_progress">#3D000000</color>
  <color name="hud_tick">#8A000000</color>
  <color name="hud_sector_pending">#61000000</color>
  <color name="hud_sector_unreached">#1F000000</color>
  <color name="fg_compass">#DE000000</color>
  <dimen name="cycling_compass_size">96dp</dimen>
  <!-- Clear of the track-recording indicator that also lives in the top-right corner. -->
  <!-- Clears the map's own compass, which drape centres 26dp down from the top-right corner. -->
  <dimen name="cycling_compass_top_allowance">52dp</dimen>
  <dimen name="cycling_spots_max_height">420dp</dimen>
  <dimen name="cycling_trace_height">280dp</dimen>
  <!-- Taller than it was: the chart now carries the elevation profile behind the lines and a
       labelled distance axis beneath them, and 160dp left the terrain squeezed into a strip. -->
  <dimen name="cycling_chart_height">210dp</dimen>
  <dimen name="cycling_thumbnail_size">64dp</dimen>
  <dimen name="cycling_zone_bar_height">28dp</dimen>
  <dimen name="cycling_status_dot">10dp</dimen>
  <!-- Wide enough to read as a bar, narrow enough that the banner stays a badge, not a panel. -->
  <dimen name="cycling_segment_progress_width">120dp</dimen>
  <!-- Full width on the segment screen, where the trend is the point rather than a hint. -->
  <dimen name="cycling_sparkline_detail_height">64dp</dimen>
  <!-- Fits "10." without the times below it shifting. -->
  <dimen name="cycling_rank_width">32dp</dimen>
  <!-- Read at speed from a bar-mounted phone, so sized like a bike computer's main figure. -->
  <dimen name="cycling_delta_text">30sp</dimen>
  <dimen name="cycling_delta_bar_height">8dp</dimen>
  <dimen name="cycling_sector_light_height">5dp</dimen>
  <dimen name="cycling_lap_result_text">44sp</dimen>
  <dimen name="cycling_lap_result_sectors">160dp</dimen>
  <dimen name="cycling_sparkline_width">56dp</dimen>
  <dimen name="cycling_sparkline_height">28dp</dimen>

  <!-- "Open Spotify" / "Open TIDAL" buttons in the music panel. Declared here rather than
       referencing the AppCompat style from code: nonTransitiveRClass keeps library resources out
       of the app's R class, so androidx styles are only reachable by name from XML. -->
  <style name="CyclingMediaAppButton" parent="Widget.AppCompat.Button.Borderless.Colored">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">start|center_vertical</item>
  </style>
  <!--
    A section heading on the cycling screen. Seventeen controls in one column with nothing grouping
    them made every setting look equally important; these say which belong together.
  -->
  <style name="CyclingSettingsHeading" parent="MwmTextAppearance.Body2">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingStart">@dimen/margin_base</item>
    <item name="android:paddingEnd">@dimen/margin_base</item>
    <item name="android:paddingTop">@dimen/margin_base</item>
    <item name="android:paddingBottom">@dimen/margin_quarter</item>
    <item name="android:textAllCaps">true</item>
  </style>

  <!--
    Scanning is what this screen exists to do, and it was styled as borderless text sitting among a
    dozen other borderless text controls. A filled button is the one thing here that should look
    like an action.
  -->
  <style name="CyclingPrimaryButton" parent="Widget.AppCompat.Button.Colored">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>
</resources>
