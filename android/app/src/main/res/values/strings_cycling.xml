<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the cycling features.

  Kept out of values/strings.xml on purpose: that file is generated from data/strings/strings.txt by
  the translation tooling, so hand-edits there are overwritten on the next regeneration and conflict
  on every rebase. Upstreaming any of this would mean moving these entries into strings.txt and
  regenerating instead.
-->
