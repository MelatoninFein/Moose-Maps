<?xml version="1.0" encoding="utf-8"?>
<!--
  Original artwork for this fork's launcher icon: two wheels, a diamond frame and handlebars.

  It exists so the app does not ship Organic Maps' logo under a different name. The Apache-2.0
  licence covers their code, not their branding.

  Drawn on the 108dp adaptive-icon canvas; the middle 72dp is the guaranteed-visible safe zone, so
  the bicycle is kept inside roughly x/y 26..82.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Rear wheel -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="4"
      android:fillColor="@android:color/transparent"
      android:pathData="M38,66m-14,0a14,14 0,1 0,28 0a14,14 0,1 0,-28 0" />

  <!-- Front wheel -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="4"
      android:fillColor="@android:color/transparent"
      android:pathData="M70,66m-14,0a14,14 0,1 0,28 0a14,14 0,1 0,-28 0" />

  <!-- Frame: down tube, seat tube, top tube and chain stay -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="4"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:fillColor="@android:color/transparent"
      android:pathData="M38,66L54,66 66,44 50,44 42,58 38,66 70,66 66,44" />

  <!-- Handlebars -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="4"
      android:strokeLineCap="round"
      android:fillColor="@android:color/transparent"
      android:pathData="M62,42L74,42" />

  <!-- Saddle -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="4"
      android:strokeLineCap="round"
      android:fillColor="@android:color/transparent"
      android:pathData="M44,42L54,42" />
</vector>
